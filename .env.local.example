# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Qdrant instance for document ingestion. Get a free cluster at
# https://cloud.qdrant.io/ (fill in QDRANT_API_KEY too), or run locally with
# `docker run -p 6333:6333 qdrant/qdrant` and leave QDRANT_API_KEY blank.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=chat_assistant_docs
